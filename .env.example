# Public project connection details (Supabase dashboard > Connect)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_LEGACY_ANON_KEY

# Server-only: use a Supabase secret key or legacy service_role key. Never NEXT_PUBLIC.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
SITE_URL=http://localhost:3000
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=GENERATE_A_RANDOM_VALUE

# Resend notifications (optional until configured)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Taimoor Portfolio <portfolio@YOUR_VERIFIED_DOMAIN>
CONTACT_TO_EMAIL=taimooraliwaris13@gmail.com
